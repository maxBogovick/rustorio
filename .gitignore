# Сборочные артефакты Gradle/Java
/build
/.gradle
*.class

# Файлы IDE
/.idea
/.vscode
*.iml

# Индекс языкового сервера Java (плагин jdtls-lsp создаёт их при первом разборе проекта).
# В git им делать нечего, а в `git status` они шумят — этот вывод попадает в контекст агентов.
/.classpath
/.project
/.factorypath
/.settings
/bin

# Прочее
.DS_Store

# Игровое сохранение (генерируется во время игры, F5/F9) — не часть исходников
/rustorio-save.json
/rustorio-save.txt

# Локальные бэкапы настроек агента
/.claude/*.bak

# Рабочие записи агентов: карточки, прогресс, аудиты, разовые код-ревью.
# Одноразовые по решению владельца (01.08.2026) — живут на диске, но не в истории.
/doc_temp

# Built by the per-mod `<id>ModJar` tasks from src/mods/<id> — outputs, not sources.
# Also covers a jar a player drops in: a mod's binary is never repository content.
resources/mods/*/*.jar

# The external mod template is a standalone Gradle build — its outputs are not repo content.
examples/external-mod-template/build/
examples/external-mod-template/.gradle/
